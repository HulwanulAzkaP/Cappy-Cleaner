<Window x:Class="CappyCleaner.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cappy Cleaner" Width="1480" Height="960" WindowState="Maximized" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#183044" Padding="24,30"><DockPanel>
   <StackPanel DockPanel.Dock="Top">
    <TextBlock Text="Cappy Cleaner" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Text="Kenali ruang di perangkat Anda" Foreground="#B5CADA" Margin="0,9,0,34" TextWrapping="Wrap"/>
    <Border Background="#29495C" CornerRadius="5" Padding="12"><StackPanel><TextBlock Text="Administrator" Foreground="#A6E1D5" FontWeight="SemiBold"/><TextBlock x:Name="AccountText" Foreground="White" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
    <TextBlock Text="Metadata saja" Foreground="White" Margin="0,32,0,6" FontWeight="SemiBold"/>
    <TextBlock Text="Scan tidak mengubah file. Link dan placeholder cloud dilewati. Akses admin tetap mengikuti proteksi Windows." Foreground="#B5CADA" TextWrapping="Wrap" LineHeight="22"/>
   </StackPanel>
   <StackPanel VerticalAlignment="Bottom"><TextBlock Text="Versi 0.1.1 • Scanner preview" Foreground="#B5CADA"/><TextBlock Text="Lokal • Tanpa telemetry" Foreground="#B5CADA" Margin="0,7,0,0"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="18,16,18,14">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel><Button DockPanel.Dock="Right" Content="Segarkan drive" VerticalAlignment="Top" Click="RefreshDrives_Click" Margin="12,0,0,0"/><StackPanel><TextBlock Text="Penyimpanan perangkat" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Mulai dari lokasi yang ingin Anda pahami." Foreground="#617487" Margin="0,5,0,18"/></StackPanel></DockPanel>
   <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="20" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
    <StackPanel><ComboBox x:Name="DrivePicker" DisplayMemberPath="Label" SelectionChanged="DrivePicker_SelectionChanged" AutomationProperties.Name="Drive lokal"/><ProgressBar x:Name="DiskBar" Maximum="100" Height="8" Margin="0,14,0,8" Foreground="{StaticResource Accent}"/><TextBlock x:Name="DiskText" Foreground="#617487" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="24,0,0,0"><TextBlock Text="Memori RAM" FontWeight="SemiBold"/><TextBlock x:Name="RamText" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="Terpisah dari penyimpanan disk" FontSize="12" Foreground="#617487" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
   </Grid></Border>
   <StackPanel Grid.Row="2">
    <DockPanel Margin="0,0,0,10"><Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Pilih folder…" Click="Browse_Click" Margin="8,0,0,0"/><TextBox x:Name="RootBox" AutomationProperties.Name="Lokasi scan"/></DockPanel>
    <DockPanel Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="FullScanButton" Content="Full scan Disk C:" Click="FullScan_Click"/><Button x:Name="CancelButton" Content="Batalkan" Click="Cancel_Click" IsEnabled="False"/><Button x:Name="ScanButton" Content="Mulai scan" Style="{StaticResource Primary}" Click="Scan_Click" Margin="0"/></StackPanel><StackPanel Margin="0,0,16,0"><TextBlock x:Name="ProgressText" Text="Belum ada scan. Pilih lokasi terlebih dahulu." TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="ScanBar" Height="4" Margin="0,9,0,0" Visibility="Collapsed"/></StackPanel></DockPanel>
   </StackPanel>
   <TabControl Grid.Row="3" x:Name="MainTabs" Background="White" BorderBrush="#DCE4EB">
    <TabItem Header="Hasil scan"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock x:Name="SummaryText" Text="Hasil akan tampil setelah scan dimulai." TextWrapping="Wrap" Margin="0,0,0,12"/>
     <DockPanel Grid.Row="1" Margin="0,0,0,10"><Button Content="Cari" Click="Search_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><ComboBox x:Name="ViewPicker" Width="180" DockPanel.Dock="Left" SelectedIndex="0" SelectionChanged="ViewPicker_SelectionChanged" Margin="0,0,8,0"><ComboBoxItem Content="Isi folder"/><ComboBoxItem Content="File terbesar"/><ComboBoxItem Content="Folder terbesar"/><ComboBoxItem Content="Akses dan pengecualian"/></ComboBox><TextBox x:Name="SearchBox" AutomationProperties.Name="Cari path" KeyDown="SearchBox_KeyDown"/></DockPanel>
     <DataGrid Grid.Row="2" x:Name="ResultsGrid" SelectionChanged="ResultsGrid_SelectionChanged" MouseDoubleClick="ResultsGrid_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Nama" MinWidth="160" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Ukuran logis" Binding="{Binding SizeLabel}" Width="125"/><DataGridTextColumn Header="Jenis" Binding="{Binding TypeLabel}" Width="75"/><DataGridTextColumn Header="Cakupan" Binding="{Binding StatusLabel}" Width="150"/></DataGrid.Columns></DataGrid>
     <DockPanel Grid.Row="3" Margin="0,10,0,8"><Button Content="Folder induk" DockPanel.Dock="Left" Click="Up_Click"/><Button x:Name="NextButton" Content="Berikutnya" DockPanel.Dock="Right" Click="Next_Click"/><Button x:Name="PreviousButton" Content="Sebelumnya" DockPanel.Dock="Right" Click="Previous_Click"/><TextBlock x:Name="PageText" VerticalAlignment="Center"/></DockPanel>
     <Border Grid.Row="4" Background="#F0F5F8" Padding="12"><StackPanel><TextBlock x:Name="DetailText" Text="Pilih item untuk melihat path dan status. Klik dua kali folder untuk menelusuri hasil." TextWrapping="Wrap" MaxHeight="85"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Salin path" Click="CopyPath_Click"/><Button x:Name="ExportButton" Content="Ekspor laporan…" Click="Export_Click" IsEnabled="False"/><Button x:Name="RefreshScanButton" Content="Scan ulang lokasi" Click="Scan_Click" IsEnabled="False"/></StackPanel></StackPanel></Border>
    </Grid></TabItem>
    <TabItem Header="Riwayat"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Snapshot berisi metadata path. Scan terputus ditandai perlu pemeriksaan." TextWrapping="Wrap" Margin="0,0,0,14"/><DataGrid Grid.Row="1" x:Name="HistoryGrid" MouseDoubleClick="History_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Waktu" Binding="{Binding StartedLabel}" Width="160"/><DataGridTextColumn Header="Lokasi" Binding="{Binding Root}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding State}" Width="140"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" Content="Buka snapshot terpilih" Click="OpenHistory_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></Grid></TabItem>
    <TabItem Header="Perlindungan"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="Lokasi terlindungi" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Tetap dihitung saat scan; tidak menjadi kandidat hapus otomatis. Satu path absolut per baris." TextWrapping="Wrap" Margin="0,8,0,12"/><TextBox x:Name="ProtectedBox" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto"/><TextBlock Text="Pengecualian scan" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,8"/><TextBlock Text="Isi lokasi ini tidak dipindai. Cakupan hasil akan ditandai sebagian." TextWrapping="Wrap" Margin="0,0,0,12"/><TextBox x:Name="ExclusionsBox" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto"/><Button Content="Simpan pengaturan" Click="SaveSettings_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/><TextBlock Text="Proteksi sistem, .git dan kredensial tidak dapat dinonaktifkan melalui pengaturan ini." TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Tentang"><ScrollViewer><StackPanel Margin="24"><TextBlock Text="Ruang lebih jelas. Keputusan tetap di tangan Anda." FontSize="22" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="Build awal menyediakan scanner metadata, cakupan, riwayat dan ekspor. Eksekusi pembersihan, inventori Appx, perbandingan snapshot dan AI belum diaktifkan. Tidak ada tombol yang menghapus file." Margin="0,18,0,0" TextWrapping="Wrap" LineHeight="24"/><TextBlock Text="Ukuran logis bukan janji ruang yang pasti pulih. Hard link, sparse file, kompresi dan aktivitas aplikasi lain memengaruhi ruang fisik. Folder induk dan anak saling mencakup; jangan menjumlahkan tabel folder terbesar." Margin="0,18,0,0" TextWrapping="Wrap" LineHeight="24"/><TextBlock x:Name="DataPathText" Margin="0,20,0,0" TextWrapping="Wrap"/><TextBlock x:Name="SidText" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <TextBlock Grid.Row="4" x:Name="StatusText" Text="Pilih drive/folder secara eksplisit. Tidak ada scan otomatis saat dibuka." Foreground="#617487" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
  </Grid>
 </Grid>
</Window>

